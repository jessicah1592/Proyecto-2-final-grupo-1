generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Profile {
  id                String    @id
  email             String    @unique
  name              String
  password          String?
  role              String    @default("user")
  bio               String?
  avatar            String?
  plan              String    @default("free")
  storageLimit      BigInt    @default(5368709120) @map("storage_limit")
  isVerified        Boolean   @default(false) @map("is_verified")
  verificationToken String?   @map("verification_token")
  resetToken        String?   @map("reset_token")
  isBlocked         Boolean   @default(false) @map("is_blocked")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@map("profiles")
}

model Folder {
  id        String    @id
  userId    String    @map("user_id")
  name      String
  parentId  String?   @map("parent_id")
  color     String?   @default("#6366f1")
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("folders")
}

model File {
  id                String    @id
  userId            String    @map("user_id")
  folderId          String?   @map("folder_id")
  name              String
  size              BigInt    @default(0)
  type              String
  mimeType          String?   @default("application/octet-stream") @map("mime_type")
  url               String?
  content           String?
  isDeleted         Boolean   @default(false) @map("is_deleted")
  deletedAt         DateTime? @map("deleted_at")
  isRestricted      Boolean   @default(false) @map("is_restricted")
  restrictionReason String?   @map("restriction_reason")
  downloadsCount    Int       @default(0) @map("downloads_count")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@map("files")
}

model DownloadLink {
  id                   String    @id
  userId               String    @map("user_id")
  targetType           String    @map("target_type")
  targetId             String    @map("target_id")
  title                String
  token                String    @unique
  password             String?
  includePasswordInUrl Boolean   @default(false) @map("include_password_in_url")
  expiresAt            DateTime? @map("expires_at")
  downloadsCount       Int       @default(0) @map("downloads_count")
  createdAt            DateTime  @default(now()) @map("created_at")

  @@map("download_links")
}

model ChatMessage {
  id           String   @id
  senderId     String   @map("sender_id")
  senderName   String   @map("sender_name")
  senderAvatar String?  @map("sender_avatar")
  channelId    String   @default("general") @map("channel_id")
  text         String
  isModerated  Boolean  @default(false) @map("is_moderated")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("chat_messages")
}